# Copy this file to ".env" and fill in real values ONLY if you want the optional
# integrations below. CampusOne works completely fine with none of these set —
# every optional feature degrades gracefully when its variables are missing.

# ---- Flask ----
# Change this to a random string for anything beyond local/demo use.
SECRET_KEY=campusone-dev-secret-change-me

# ---- Email notifications (optional) ----
# If left blank, the app shows "Email notification queued/unavailable" instead
# of sending, and continues working normally.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# ---- WhatsApp notifications (optional, abstraction only) ----
# No paid WhatsApp API is required for the core app. If left blank, WhatsApp
# status shows "Not configured" everywhere it would otherwise be used.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ---- AI Campus Assistant (optional) ----
# The assistant works with a built-in rule-based engine even with nothing set
# here. Set one of these to route questions to a real LLM instead (not wired
# to a specific provider out of the box — this is left as an integration point).
GEMINI_API_KEY=AQ.Ab8RN6Kp3fN_9VdjIeUXegLTwvKBdw5vYt5RoRFMzLDRp7Bq1Q
OLLAMA_HOST=
